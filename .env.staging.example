# ==============================================================================
# KAMADHENU HONEY FARMS — STAGING / VERCEL PREVIEW ENVIRONMENT TEMPLATE
# ==============================================================================
# SAFETY RULES:
# 1. NEVER point staging/Preview DATABASE_URL or DIRECT_URL at Production Supabase.
# 2. NEVER reuse Production JWT_SECRET, ORDER_TOKEN_SECRET, or gateway live keys.
# 3. NEVER deploy plaintext ADMIN_PASSWORD — generate a salted scrypt hash instead:
#    node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex'); console.log('scrypt:'+s+':'+c.scryptSync('YOUR_STAGING_ADMIN_PW',s,64).toString('hex'))"
# ==============================================================================

# 1. Separate Supabase Staging Database
DATABASE_URL="postgresql://postgres.<STAGING_PROJECT_REF>:<STAGING_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.<STAGING_PROJECT_REF>:<STAGING_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require"

# 2. App URL (Vercel Preview Deployment URL)
NEXT_PUBLIC_APP_URL="https://<your-preview-branch-url>.vercel.app"

# 3. Authentication & HMAC Secrets (minimum 32 random characters, distinct from Production)
JWT_SECRET="replace-with-64-char-hex-staging-jwt-secret"
ORDER_TOKEN_SECRET="replace-with-64-char-hex-staging-order-token-secret"
ADMIN_EMAIL="admin@kamadhenuhoneyfarms.in"
ADMIN_PASSWORD_HASH="scrypt:<32-char-hex-salt>:<128-char-scrypt-derived-hex>"

# 4. Distributed Rate Limiting & Admin Token Revocation (Upstash Redis REST)
UPSTASH_REDIS_REST_URL="https://<your-staging-upstash-endpoint>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<your-staging-upstash-rest-token>"

# 5. Cashfree Payment Gateway — STRICTLY SANDBOX ONLY
CASHFREE_ENV="SANDBOX"
CASHFREE_APP_ID="<cashfree-sandbox-client-id>"
CASHFREE_CLIENT_ID="<cashfree-sandbox-client-id>"
CASHFREE_SECRET_KEY="<cashfree-sandbox-client-secret>"
CASHFREE_CLIENT_SECRET="<cashfree-sandbox-client-secret>"

# 6. Razorpay Payment Gateway (if enabled in Preview — Test Mode only)
RAZORPAY_KEY_ID="rzp_test_<your_test_key>"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_<your_test_key>"
RAZORPAY_KEY_SECRET="<your_razorpay_test_secret>"
RAZORPAY_WEBHOOK_SECRET="<your_razorpay_staging_webhook_secret>"

# 7. Shipping / Courier Integration (Staging or disabled)
SHIPROCKET_EMAIL=""
SHIPROCKET_PASSWORD=""
ALLOW_TEST_PINCODE="true"

# 8. Transactional Email (Staging SMTP / Sandbox inbox e.g. Mailtrap or Resend test)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="<staging-smtp-user>"
SMTP_PASS="<staging-smtp-app-password>"
ADMIN_NOTIFICATION_EMAIL="<staging-admin-alert-email>"

# 9. Firebase Push Notifications (Staging Firebase Project)
FIREBASE_PROJECT_ID="<staging-firebase-project-id>"
FIREBASE_CLIENT_EMAIL="<staging-firebase-client-email>"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<STAGING_PRIVATE_KEY>\n-----END PRIVATE KEY-----\n"
NEXT_PUBLIC_FIREBASE_API_KEY="<staging-firebase-web-api-key>"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<staging-firebase-project-id>.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="<staging-firebase-project-id>"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<staging-firebase-project-id>.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="<staging-sender-id>"
NEXT_PUBLIC_FIREBASE_APP_ID="<staging-app-id>"
NEXT_PUBLIC_FIREBASE_VAPID_KEY="<staging-vapid-key>"

# 10. Cloudinary File Uploads (Staging folder/preset or sandbox cloud)
CLOUDINARY_CLOUD_NAME="<staging-cloud-name>"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<staging-cloud-name>"
CLOUDINARY_API_KEY="<staging-cloudinary-api-key>"
CLOUDINARY_API_SECRET="<staging-cloudinary-api-secret>"
