# ==============================================================================
# Kamadhenu Honey Farms - Environment Variables Example
# Copy this file to .env and configure all production values securely.
# ==============================================================================

# Database Connection (PostgreSQL via Prisma & Supabase/Neon)
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Canonical Origin / Base URL
NEXT_PUBLIC_APP_URL="https://kamadhenuhoneyfarms.in"

# JWT Authentication & HMAC Order Tokens
# Generate strong random 64-byte hex strings: openssl rand -hex 64
JWT_SECRET="your-secure-jwt-secret-here"
ORDER_TOKEN_SECRET="your-secure-order-token-secret-here"

# Admin Portal Credentials (salted scrypt hash — never plaintext ADMIN_PASSWORD)
# Generate: node -e "const c=require('crypto'),s=c.randomBytes(16).toString('hex'); console.log('scrypt:'+s+':'+c.scryptSync('YOUR_ADMIN_PW',s,64).toString('hex'))"
ADMIN_EMAIL="admin@kamadhenuhoneyfarms.in"
ADMIN_PASSWORD_HASH="scrypt:<salt_hex>:<derived_hex>"

# Shared Distributed Security (Upstash Redis REST — rate limiting, revocation, checkout locks)
UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Cashfree Payment Gateway (Production / Sandbox)
CASHFREE_CLIENT_ID="your-cashfree-app-id"
CASHFREE_CLIENT_SECRET="your-cashfree-secret-key"
CASHFREE_ENV="production"

# Razorpay Payment Gateway (Optional / Secondary)
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"

# Cloudinary Storage (Candidate Documents & Receipts)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# SMTP Mailer (Order Invoices, Recruitment & Candidate Communications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-notification-email@domain.com"
SMTP_PASS="your-smtp-app-password"
ADMIN_NOTIFICATION_EMAIL="kamadhenuhoneyfarms@gmail.com"

# Shiprocket Courier API (Optional)
SHIPROCKET_EMAIL="your-shiprocket-email"
SHIPROCKET_PASSWORD="your-shiprocket-password"
SHIPROCKET_TOKEN="your-shiprocket-token"
